function miniChartSVG(kind){
  // kind: 'correct' | 'no_impulse' | 'gradual' | 'wrong_candle'
  const w=260,h=150;
  let candles=[];
  if(kind==='correct'){
    candles=[{r:1,t:70,h:14},{r:1,t:75,h:12},{r:1,t:85,h:18,mark:1},{r:0,t:40,h:45},{r:0,t:10,h:30},{r:0,t:0,h:10}];
  }else if(kind==='no_impulse'){
    candles=[{r:1,t:70,h:14},{r:1,t:75,h:12},{r:1,t:85,h:18,mark:1},{r:0,t:78,h:10},{r:1,t:80,h:12},{r:0,t:76,h:14}];
  }else if(kind==='gradual'){
    candles=[{r:1,t:70,h:14},{r:1,t:75,h:12},{r:1,t:85,h:18,mark:1},{r:0,t:78,h:12},{r:0,t:70,h:12},{r:0,t:62,h:12}];
  }else if(kind==='wrong_candle'){
    candles=[{r:0,t:95,h:20},{r:0,t:60,h:35},{r:0,t:20,h:30,mark:1},{r:0,t:5,h:15},{r:1,t:8,h:10},{r:0,t:2,h:8}];
  }
  const gap=w/candles.length;
  let svg='<svg viewBox="0 0 '+w+' '+h+'" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;background:#0a0f1e;border-radius:8px;">';
  candles.forEach((c,i)=>{
    const x=gap*i+gap/2;
    const color=c.r?'#FF4466':'#00FF88';
    if(c.mark){svg+='<rect x="'+(x-16)+'" y="'+(c.t-4)+'" width="32" height="'+(c.h+8)+'" fill="none" stroke="#FFD700" stroke-width="2" stroke-dasharray="3,2" rx="4"/>';}
    svg+='<rect x="'+(x-8)+'" y="'+c.t+'" width="16" height="'+c.h+'" fill="'+color+'" rx="2"/>';
    svg+='<line x1="'+x+'" y1="'+(c.t-8)+'" x2="'+x+'" y2="'+(c.t+c.h+8)+'" stroke="'+color+'" stroke-width="2"/>';
  });
  svg+='</svg>';
  return svg;
}
const ex2Options=[
  {kind:'gradual',label:'GRAPHIQUE B',correct:false},
  {kind:'correct',label:'GRAPHIQUE A',correct:true},
  {kind:'wrong_candle',label:'GRAPHIQUE C',correct:false},
  {kind:'no_impulse',label:'GRAPHIQUE D',correct:false}
];
let ex2Done=false;
