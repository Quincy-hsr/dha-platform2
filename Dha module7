.info-box{padding:16px 20px;border-radius:14px;margin:16px 0;font-size:14px;line-height:1.7;}
.info-box.cyan{background:rgba(0,212,255,0.06);border-left:3px solid var(--cyan);color:rgba(232,244,255,0.8);}
.info-box.gold{background:rgba(255,215,0,0.06);border-left:3px solid var(--gold);color:rgba(255,215,0,0.9);}
.info-box.green{background:rgba(0,255,136,0.06);border-left:3px solid var(--green);color:rgba(0,255,136,0.9);}
.info-box.red{background:rgba(255,68,102,0.06);border-left:3px solid var(--red);color:rgba(255,68,102,0.9);}
.quiz-section{background:linear-gradient(135deg,rgba(157,78,221,0.08),rgba(30,100,255,0.05));border:1px solid rgba(157,78,221,0.2);border-radius:16px;padding:24px;margin-top:24px;}
.quiz-header{display:flex;align-items:center;gap:10px;margin-bottom:20px;}
.quiz-title{font-family:'Orbitron',sans-serif;font-size:14px;font-weight:900;color:var(--white);letter-spacing:1px;}
.quiz-xp{margin-left:auto;font-family:'Orbitron',sans-serif;font-size:10px;color:var(--gold);background:rgba(255,215,0,0.1);border:1px solid rgba(255,215,0,0.25);padding:4px 10px;border-radius:6px;}
.quiz-question{margin-bottom:20px;}
.quiz-q-num{font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:2px;color:var(--purple);margin-bottom:8px;}
.quiz-q-text{font-size:15px;color:var(--white);font-weight:600;margin-bottom:12px;line-height:1.5;}
.quiz-options{display:flex;flex-direction:column;gap:8px;}
.quiz-option{padding:12px 16px;border-radius:10px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);cursor:pointer;transition:all .2s;font-size:14px;color:var(--dim);display:flex;align-items:center;gap:10px;}
.quiz-option:hover{border-color:rgba(157,78,221,0.4);background:rgba(157,78,221,0.08);color:var(--white);}
.quiz-option.correct{border-color:rgba(0,255,136,0.5);background:rgba(0,255,136,0.1);color:var(--green);}
.quiz-option.wrong{border-color:rgba(255,68,102,0.5);background:rgba(255,68,102,0.1);color:var(--red);}
.quiz-option-letter{width:24px;height:24px;border-radius:6px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;font-family:'Orbitron',sans-serif;font-size:10px;font-weight:900;flex-shrink:0;}
.quiz-feedback{display:none;padding:12px 16px;border-radius:10px;font-size:13px;margin-top:10px;line-height:1.6;}
.quiz-feedback.show{display:block;}
.quiz-feedback.correct{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.2);color:rgba(0,255,136,0.9);}
.quiz-feedback.wrong{background:rgba(255,68,102,0.08);border:1px solid rgba(255,68,102,0.2);color:rgba(255,68,102,0.9);}
