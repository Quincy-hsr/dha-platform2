  await awardXP('quete_bloc_'+todayISO(),50,'📚 Finir un module (quête du jour)');
  setTimeout(()=>{window.location.href='dha-formation.html';},1500);
}

async function init(){
  const stored=localStorage.getItem('dha_member');
  if(!stored){window.location.href='dha-connexion.html';return;}
  member=JSON.parse(stored);
  document.getElementById('sb-pseudo').textContent=('@'+(member.pseudo||'HUSTLER')).toUpperCase();
  document.getElementById('topbar-xp').textContent=(member.xp||0)+' XP';
  if(member.avatar){document.getElementById('sb-avatar').innerHTML='<img src="'+member.avatar+'" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"/>';}
  try{
    const res=await fetch(SUPABASE_URL+'/rest/v1/membres?email=eq.'+encodeURIComponent(member.email).replace(/\./g,'%2E')+'&select=xp,xp_semaine',{
      headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY}
    });
    const data=await res.json();
    if(data&&data.length>0){
      member.xp=data[0].xp!=null?data[0].xp:member.xp;
      member.xp_semaine=data[0].xp_semaine!=null?data[0].xp_semaine:member.xp_semaine;
      localStorage.setItem('dha_member',JSON.stringify(member));
      document.getElementById('topbar-xp').textContent=member.xp+' XP';
    }
  }catch(e){}
  await loadCompletedActions(member.pseudo||'guest',['bloc_m7_b1','quiz_m7_b1','exercice1_m7_b1','exercice2_m7_b1','exercice3_m7_b1']);
  if(completedActions.has('bloc_m7_b1')){document.getElementById('complete-btn').textContent='✅ DÉJÀ TERMINÉ';document.getElementById('complete-btn').disabled=true;}
  if(completedActions.has('quiz_m7_b1')){document.getElementById('quiz-btn').textContent='✅ QUIZ DÉJÀ FAIT';document.getElementById('quiz-btn').disabled=true;quizDone=true;}
  if(completedActions.has('exercice1_m7_b1')){ex1Done=true;const btn=document.getElementById('ex1-btn');btn.disabled=true;btn.textContent='✅ DÉJÀ VALIDÉ';}
  if(completedActions.has('exercice2_m7_b1')){ex2Done=true;const btn=document.getElementById('ex2-btn');btn.disabled=true;btn.textContent='✅ DÉJÀ VALIDÉ';}
  if(completedActions.has('exercice3_m7_b1')){ex3Done=true;const btn=document.getElementById('ex3-btn');btn.disabled=true;btn.textContent='✅ DÉJÀ VALIDÉ';}
}

init();
</script>
