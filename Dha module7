.module-tag{font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:3px;color:var(--cyan);margin-bottom:10px;}
.module-title{font-family:'Orbitron',sans-serif;font-size:28px;font-weight:900;color:var(--white);margin-bottom:8px;line-height:1.2;}
.module-desc{font-size:14px;color:var(--dim);line-height:1.7;}
.module-meta{display:flex;gap:16px;margin-top:20px;flex-wrap:wrap;}
.module-meta-item{display:flex;align-items:center;gap:6px;font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:1px;color:var(--dim);padding:6px 12px;border-radius:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);}
.bloc{background:var(--card);border:1px solid var(--border);border-radius:20px;margin-bottom:24px;overflow:hidden;}
.bloc-header{padding:24px 28px;border-bottom:1px solid rgba(255,255,255,0.05);}
.bloc-num{font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:3px;color:var(--cyan);margin-bottom:8px;}
.bloc-title{font-family:'Orbitron',sans-serif;font-size:18px;font-weight:900;color:var(--white);letter-spacing:1px;}
