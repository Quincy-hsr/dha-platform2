/* ============ EXERCICE 3 : DRAG & DROP ============ */
const ex3Candles=[
  {red:1,bTop:105,bH:24,wTop:95,wH:44},
  {red:0,bTop:95,bH:20,wTop:85,wH:40},
  {red:1,bTop:112,bH:22,wTop:102,wH:42},
  {red:0,bTop:100,bH:18,wTop:90,wH:38},
  {red:1,bTop:118,bH:34,wTop:103,wH:64},
  {red:0,bTop:50,bH:68,wTop:40,wH:88},
  {red:0,bTop:18,bH:52,wTop:8,wH:72},
  {red:0,bTop:4,bH:32,wTop:0,wH:42}
];
const ex3Correct=4;
let ex3Done=false;
renderCandles('ex3-cols',ex3Candles,null);

(function setupDrag(){
  const zone=document.getElementById('ex3-zone');
  const chart=document.getElementById('ex3-cols');
  let dragging=false;
  let startX=0,startY=0,origLeft=0,origTop=0;
  let originalParent=zone.parentElement;
  zone.style.position='relative';

  function pointerDown(e){
    if(ex3Done)return;
    dragging=true;
    zone.classList.add('dragging');
    const rect=zone.getBoundingClientRect();
    zone.style.position='fixed';
    zone.style.left=rect.left+'px';
    zone.style.top=rect.top+'px';
    zone.style.zIndex=9999;
    document.body.appendChild(zone);
    const clientX=e.touches?e.touches[0].clientX:e.clientX;
    const clientY=e.touches?e.touches[0].clientY:e.clientY;
    startX=clientX-rect.left;startY=clientY-rect.top;
    e.preventDefault();
  }
  function pointerMove(e){
    if(!dragging)return;
    const clientX=e.touches?e.touches[0].clientX:e.clientX;
    const clientY=e.touches?e.touches[0].clientY:e.clientY;
    zone.style.left=(clientX-startX)+'px';
    zone.style.top=(clientY-startY)+'px';
  }
  function pointerUp(e){
    if(!dragging)return;
    dragging=false;
    zone.classList.remove('dragging');
    const zRect=zone.getBoundingClientRect();
    const zCenterX=zRect.left+zRect.width/2;
    const zCenterY=zRect.top+zRect.height/2;
    const chartRect=chart.getBoundingClientRect();
    const overChart=zCenterX>=chartRect.left&&zCenterX<=chartRect.right&&zCenterY>=chartRect.top&&zCenterY<=chartRect.bottom;
    if(overChart){
      const relX=zCenterX-chartRect.left;
      const colWidth=chartRect.width/ex3Candles.length;
      const idx=Math.min(ex3Candles.length-1,Math.max(0,Math.floor(relX/colWidth)));
      if(idx===ex3Correct){
        ex3Done=true;
        zone.classList.add('placed');
        zone.style.position='absolute';
        zone.style.left=(idx*colWidth+colWidth/2-35)+'px';
        zone.style.top='95px';
        zone.style.zIndex=5;
        chart.appendChild(zone);
        const hint=document.getElementById('ex3-hint');hint.className='ex-hint show correct';hint.textContent='✅ Parfait ! Zone placée pile sur l\'Order Block.';
        const btn=document.getElementById('ex3-btn');btn.disabled=false;btn.classList.add('ready');
        btn.onclick=function(){if(completedActions.has('exercice3_m7_b1'))return;btn.disabled=true;btn.textContent='✅ EXERCICE 3 VALIDÉ !';awardXP('exercice3_m7_b1',25,'💪 Exercice 3 Module 7');};
        return;
      }else{
        zone.classList.add('placed-wrong');
        setTimeout(()=>zone.classList.remove('placed-wrong'),700);
        const hint=document.getElementById('ex3-hint');hint.className='ex-hint show wrong';hint.textContent='❌ Pas la bonne bougie — cherche la dernière rouge juste avant le grand mouvement vert.';
      }
    }
    resetZone();
  }
  function resetZone(){
    zone.style.position='relative';
    zone.style.left='';zone.style.top='';zone.style.zIndex='';
    document.querySelector('.zone-tray').appendChild(zone);
  }
  zone.addEventListener('mousedown',pointerDown);
  zone.addEventListener('touchstart',pointerDown,{passive:false});
  document.addEventListener('mousemove',pointerMove);
  document.addEventListener('touchmove',pointerMove,{passive:false});
  document.addEventListener('mouseup',pointerUp);
  document.addEventListener('touchend',pointerUp);
})();

function sendQuestion(){
  const q=document.getElementById('question-input').value.trim();
  if(!q){alert('Écris ta question d\'abord !');return;}
  fetch(FORMSPREE,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({sujet:'Question Module 7 Bloc 1',question:q,membre:member?member.email:'inconnu'})});
  document.getElementById('question-input').value='';
  document.getElementById('question-confirm').classList.add('show');
}

