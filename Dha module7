.quiz-submit:disabled{opacity:0.5;cursor:not-allowed;}
.quiz-result{display:none;text-align:center;padding:20px;border-radius:12px;background:rgba(255,215,0,0.06);border:1px solid rgba(255,215,0,0.2);margin-top:16px;}
.quiz-result.show{display:block;}
.quiz-result-score{font-family:'Orbitron',sans-serif;font-size:40px;font-weight:900;color:var(--gold);}
.quiz-result-xp{font-family:'Orbitron',sans-serif;font-size:14px;color:var(--green);margin-top:8px;}
.exercice-section{background:rgba(0,212,255,0.05);border:1px solid rgba(0,212,255,0.2);border-radius:16px;padding:24px;margin-top:16px;}
.exercice-title{font-family:'Orbitron',sans-serif;font-size:13px;font-weight:900;color:var(--cyan);letter-spacing:1px;margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.exercice-desc{font-size:13px;color:rgba(232,244,255,0.7);line-height:1.7;margin-bottom:16px;}
.ex-chart{position:relative;height:230px;background:#0a0f1e;border-radius:14px;border:1px solid rgba(30,100,255,0.2);margin-bottom:14px;overflow:hidden;}
.ex-cols{position:absolute;inset:0;display:flex;}
.ex-col{position:relative;flex:1;height:100%;cursor:pointer;border-right:1px solid rgba(255,255,255,0.02);}
.ex-col:last-child{border-right:none;}
.ex-col:hover{background:rgba(0,212,255,0.06);}
.ex-col.locked{cursor:default;}
.ex-wick{position:absolute;left:50%;transform:translateX(-50%);width:3px;border-radius:2px;}
.ex-body{position:absolute;left:50%;transform:translateX(-50%);width:60%;max-width:30px;border-radius:3px;}
.ex-body.red{background:var(--red);}
.ex-body.green{background:var(--green);}
.ex-wick.red{background:var(--red);}
.ex-wick.green{background:var(--green);}
.ex-col.selected .ex-body{outline:2px solid var(--gold);outline-offset:2px;}
.ex-col.correct-reveal .ex-body{outline:2px solid var(--green);outline-offset:2px;box-shadow:0 0 14px rgba(0,255,136,0.6);}
.ex-hint{font-size:13px;padding:10px 14px;border-radius:10px;margin-bottom:12px;display:none;line-height:1.6;}
.ex-hint.show{display:block;}
.ex-hint.wrong{background:rgba(255,68,102,0.08);border:1px solid rgba(255,68,102,0.2);color:rgba(255,68,102,0.9);}
.ex-hint.correct{background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.2);color:rgba(0,255,136,0.9);}
.qcm-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.qcm-card{background:#0a0f1e;border:2px solid rgba(30,100,255,0.15);border-radius:14px;padding:10px;cursor:pointer;transition:all .2s;}
.qcm-card:hover{border-color:rgba(0,212,255,0.4);}
.qcm-card.selected-correct{border-color:var(--green);box-shadow:0 0 14px rgba(0,255,136,0.4);}
.qcm-card.selected-wrong{border-color:var(--red);box-shadow:0 0 14px rgba(255,68,102,0.3);}
.qcm-label{text-align:center;font-family:'Orbitron',sans-serif;font-size:9px;letter-spacing:1px;color:var(--dim);margin-top:8px;}
.zone-tray{display:flex;justify-content:center;margin-bottom:14px;}
.zone-piece{width:70px;height:44px;border:2px dashed var(--gold);border-radius:8px;background:rgba(255,215,0,0.1);cursor:grab;display:flex;align-items:center;justify-content:center;font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:1px;color:var(--gold);text-align:center;user-select:none;transition:transform .15s;}
.zone-piece.dragging{cursor:grabbing;opacity:0.8;}
.zone-piece.placed{border-color:var(--green);background:rgba(0,255,136,0.1);color:var(--green);}
.zone-piece.placed-wrong{border-color:var(--red);background:rgba(255,68,102,0.1);color:var(--red);}
.exercice-validate{width:100%;padding:13px;border-radius:12px;background:linear-gradient(135deg,#006644,var(--green));color:#000;font-family:'Orbitron',sans-serif;font-size:11px;font-weight:900;letter-spacing:2px;border:none;cursor:not-allowed;transition:all .2s;opacity:0.4;}
.exercice-validate.ready{cursor:pointer;opacity:1;}
.exercice-validate:disabled{opacity:0.5;cursor:not-allowed;}
.question-box{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;margin-top:16px;}
.question-box-title{font-family:'Orbitron',sans-serif;font-size:12px;font-weight:900;color:var(--white);letter-spacing:1px;margin-bottom:8px;}
.question-box-desc{font-size:13px;color:var(--dim);margin-bottom:16px;line-height:1.6;font-style:italic;}
.question-box-input{width:100%;padding:14px 16px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--white);font-family:'Exo 2',sans-serif;font-size:14px;outline:none;resize:vertical;min-height:100px;}
.question-box-input::placeholder{color:rgba(255,255,255,0.2);}
.question-box-send{width:100%;padding:13px;border-radius:12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:var(--white);font-family:'Orbitron',sans-serif;font-size:10px;font-weight:900;letter-spacing:2px;cursor:pointer;margin-top:10px;}
.question-box-confirm{display:none;padding:12px;border-radius:10px;background:rgba(0,255,136,0.08);border:1px solid rgba(0,255,136,0.2);font-size:13px;color:var(--green);text-align:center;margin-top:10px;}
.question-box-confirm.show{display:block;}
.complete-btn{width:100%;padding:16px;border-radius:14px;background:linear-gradient(135deg,var(--blue),var(--cyan));color:#000;font-family:'Orbitron',sans-serif;font-size:12px;font-weight:900;letter-spacing:2px;border:none;cursor:pointer;margin-top:24px;box-shadow:0 6px 24px rgba(0,212,255,0.3);}
.complete-btn:disabled{opacity:0.5;cursor:not-allowed;}
@keyframes xp-pop{0%{opacity:1;transform:translate(-50%,-50%) scale(0.8);}60%{opacity:1;transform:translate(-50%,-80%) scale(1.2);}100%{opacity:0;transform:translate(-50%,-120%) scale(0.9);}}
@media(max-width:768px){.sidebar{display:none;}.main{margin-left:0;padding:16px;}.qcm-grid{grid-template-columns:1fr;}}
</style>
